# D3sk.AgentCli reads these from the process environment (none is required). Non-secret only.

# Bridge home: token files, security log, sessions (default: ~/.agent-cli-bridge).
# AGENT_CLI_BRIDGE_HOME=

# Security log of every turn on this machine (default: <bridge home>/security-log.jsonl; off disables).
# AGENT_CLI_BRIDGE_SECURITY_LOG=

# Base URL used in the security events' details_url links.
# AGENT_CLI_BRIDGE_URL=

# Folder whose agent_cli_bridge.json is the shared settings (default: the checkout's config.local/).
# Empty or none skips that folder and leaves only ~/.agent_cli_bridge.json.
# AGENT_CLI_BRIDGE_CONFIG_LOCAL=

# Folder the launcher shims go in (default: a per-user cache folder).
# AGENT_CLI_BRIDGE_SHIM_DIR=

# D3SKWEBSCOUT checkout and socket, when the optional web scout is not found automatically.
# D3SKWEBSCOUT_DIR=
# D3SKWEBSCOUT_SOCKET=
