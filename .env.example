# AgentCliBridge gateway — copy to .env if you need to override defaults.
# Local CLIs: Claude Code, Cursor Agent, Gemini CLI, Antigravity, Grok, Copilot, OpenCode.
# The port is FIXED (launcher/bookmark contract) — pick another here if 4747 is taken.
PORT=4747

# Upstream OpenAI-compatible server for non-CLI model ids (e.g. a local MLX, Ollama or llama.cpp server).
# BRIDGE_UPSTREAM_OPENAI=http://127.0.0.1:8899/v1

# CLI permission mode: plan (default) | acceptEdits | auto | manual | dontAsk | bypassPermissions
# plan is that CLI's plan or ask setting. It does not by itself block every write or shell.
# BRIDGE_PERMISSION_MODE=plan

# Working directory the CLIs run in (default: <bridge home>-work, beside it).
# BRIDGE_WORKDIR=

# Bridge home for the token files, security log, and sessions (default: ~/.agent-cli-bridge).
# AGENT_CLI_BRIDGE_HOME=

# Bearer tokens: by default each is created on first start in the bridge home
# (gateway-token for apps, gateway-owner-token for the owner and the web UI). They are secrets:
# set these only from a secret store, never in this file.
# BRIDGE_TOKEN=
# BRIDGE_OWNER_TOKEN=

# Security log of every turn on this machine (default: <bridge home>/security-log.jsonl; off disables)
# AGENT_CLI_BRIDGE_SECURITY_LOG=

# Gateway base URL used in the security events' details_url links (default: http://127.0.0.1:4747)
# AGENT_CLI_BRIDGE_URL=

# Folder whose agent_cli_bridge.json is the shared settings (default: the checkout's config.local/).
# Empty or none skips that folder and leaves only ~/.agent_cli_bridge.json.
# AGENT_CLI_BRIDGE_CONFIG_LOCAL=

# D3SKWEBSCOUT checkout. When unset, the gateway looks under $AI_CODE_ROOT, then ~/Code and ~/CODE.
# D3SKWEBSCOUT_DIR=

# Code root used to find the AgentCliBridge checkout and, with no D3SKWEBSCOUT_DIR, the scout.
# AI_CODE_ROOT=

# Where coli setup keeps setup.json for colibri. Unset uses the OS data directory.
# COLI_SETUP_HOME=

# WebScout on gateway turns. 0, off, or false (any case) disables it.
# BRIDGE_WEB_SCOUT=

# Folder the launcher shims go in (default: ~/.cache/agent-cli-bridge/bin, or %LOCALAPPDATA% on
# Windows). The installer sets it to <install>/cache/bin so nothing lands in the user profile.
# AGENT_CLI_BRIDGE_SHIM_DIR=

# Install folder of a packaged install (setup.sh / setup.ps1). The launchers it writes set this;
# start.sh, stop.sh and install.sh then use its venv/, state/, logs/ and gateway.env.
# AGENT_CLI_BRIDGE_INSTALL_DIR=
