<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>D3sk.AgentCli</PackageId>
    <Description>Runs the AI coding CLIs (Claude Code, Cursor, Gemini, Copilot, Grok, OpenCode) and folds their output streams into typed events. .NET port of AgentCliBridge.</Description>
    <Authors>neijix</Authors>
    <Copyright>Copyright (c) 2026 neijix</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/neijix/AgentCliBridge</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/neijix/AgentCliBridge</PackageProjectUrl>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <!-- The web page files a consumer serves (the hub's /acb). They ride in the package under
         buildTransitive/ui and the .targets copies them to <output>/acb/ at build and publish. -->
    <None Include="ui/*" Pack="true" PackagePath="buildTransitive/ui/" />
    <None Include="buildTransitive/D3sk.AgentCli.targets" Pack="true" PackagePath="buildTransitive/" />
    <InternalsVisibleTo Include="D3sk.AgentCli.Tests" />
  </ItemGroup>
</Project>
